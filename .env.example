# PiNAS environment configuration
# Copie para .env e preencha. NUNCA comite .env no git.

# Hostname mDNS (acessível pela LAN como https://pinas.local)
PINAS_HOST=pinas.local
PINAS_ALLOWED_ORIGIN=https://pinas.local

# Admin inicial — criado na primeira subida do banco
PINAS_ADMIN_USERNAME=admin
PINAS_ADMIN_PASSWORD=troque-isto-imediatamente

# Ambiente: development | production
PINAS_ENV=production
PINAS_LOG_LEVEL=info

# Timezone
TZ=America/Sao_Paulo
