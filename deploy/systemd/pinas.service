# PiNAS — systemd unit opcional
# Sobe o stack docker-compose no boot. Coloque em /etc/systemd/system/pinas.service.
#
# sudo cp deploy/systemd/pinas.service /etc/systemd/system/
# sudo systemctl daemon-reload
# sudo systemctl enable --now pinas

[Unit]
Description=PiNAS stack (Caddy + API)
Requires=docker.service
After=docker.service network-online.target srv-pinas-data.mount
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pinas
EnvironmentFile=/opt/pinas/.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
